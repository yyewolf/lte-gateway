	(symbol (lib_id "power:GND") (at 383.54 114.3 0) (unit 1) (exclude_from_sim no) (in_bom no) (on_board no) (dnp no) (uuid "9024d4a3-ef3b-4d64-a7a8-3fc14f25cf1f") (property "Reference" "#PWR943" (at 383.54 114.3 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Value" "GND" (at 383.54 118.11 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Footprint" "" (at 383.54 114.3 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 383.54 114.3 0) (hide yes) (effects (font (size 1.27 1.27))))(pin "1" (uuid "b1ffc656-63c3-4631-bc8e-eb5358ad79c5"))(instances (project "sms" (path "/87f5d4ab-27a5-46ca-95f3-e4337681b616/514f6c70-faa1-493a-a63b-d4135b6d9ee6" (reference "#PWR943") (unit 1)))))
	(symbol (lib_id "power:GND") (at 369.57 116.84 0) (unit 1) (exclude_from_sim no) (in_bom no) (on_board no) (dnp no) (uuid "83040ea2-30dd-4b8d-b545-59b4ab2baa91") (property "Reference" "#PWR944" (at 369.57 116.84 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Value" "GND" (at 369.57 120.65 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Footprint" "" (at 369.57 116.84 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 369.57 116.84 0) (hide yes) (effects (font (size 1.27 1.27))))(pin "1" (uuid "97b42749-4f85-4169-8871-726f4070ff9f"))(instances (project "sms" (path "/87f5d4ab-27a5-46ca-95f3-e4337681b616/514f6c70-faa1-493a-a63b-d4135b6d9ee6" (reference "#PWR944") (unit 1)))))
	(hierarchical_label "MODEM_RESET_CTL" (shape bidirectional) (at 350.52 109.22 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "b07442ed-98a4-4d60-aabe-815e008b9f4c"))
	(text "A7670E-LASE LTE Cat-1 modem (VoLTE, 2G fallback)" (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left top)) (uuid "06dd2706-9215-4bd0-b356-668b9862fad4"))
	(text "UART: 100R in series on TXD/RXD at the module (SIMCom).\nThe other UART lines go straight to the level shifter sheet.\n\nAudio lines: 33 pF to GND right at the module pins (RF filtering).\n\nSIM: 22R series + one TPD1E10B06 ESD diode per line near the holder, 100n + 33p\non SIM_VDD (SIMCom reference). Keep the holder far from the antenna.\nThe ESD diodes join the SIM lines through the SIM_* labels." (exclude_from_sim no) (at 15.24 27.94 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0b81e608-2407-4608-a41f-51e040be5fa8"))
	(text "Modem USB-C (J303): only for modem firmware updates and SIMCom\ndebug tools. It does not power the board. VBUS just tells the\nmodem a host is present." (exclude_from_sim no) (at 15.24 132.08 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "25627ffb-0f18-473e-af35-0f683b019616"))
	(text "Antenna: short 50R trace (< 20 mm) from ANT_MAIN to the u.FL.\nPi network R312 / C309 / C310 is for matching (0R + DNP until\ntuned), C311 100pF per SIMCom for ESD, D302 low-capacitance\nTVS optional (DNP)." (exclude_from_sim no) (at 15.24 215.9 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7fe6b64b-c657-4f7d-b6f9-affa9410cbaf"))
	(text "VBAT = SIMCom Figure 4: TVS D301 and bead FB301 at the entry,\nthen >= 200 uF bulk (C301 220uF tantalum + C302 100uF) and\n1u/100n/33p/10p at the pins. Route VBAT >= 2 mm wide.\nR315 (0R 1206) is a current link: remove it to put an ammeter\nor a bench supply across its pads. TP305 sits at the module\nVBAT pins, TP306 is a scope ground loop (DNP)." (exclude_from_sim no) (at 15.24 231.14 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9ca785a1-7547-4149-8cb4-86bf5b308b3c"))
	(text "PWRKEY / RESET: active-low inputs pulled up to VBAT inside the\nmodule. The ESP32 drives them through NPN transistors (SIMCom\nreference: 4.7k / 47k / 1k). PWRKEY low 50 ms = power on,\n2.5 s = power off. RESET low 2.5 s = reset. Never pull both low\nat the same time. No capacitor > 10 pF on these pins." (exclude_from_sim no) (at 15.24 254.0 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1589eb2d-3bad-4214-9329-39fa1c188241"))
	(text "Test pads (SIMCom asks for USB_BOOT, UART_LOG_TX, VDD_1V8 and GND).\nTP301 (USB_BOOT) forces the modem's USB download mode at power-up\n(level per the A7670 hardware design guide)." (exclude_from_sim no) (at 335.28 63.5 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "eb78cc3e-61a7-4276-a30d-37307668b414"))
