	(symbol (lib_id "power:GND") (at 231.14 115.57 0) (unit 1) (exclude_from_sim no) (in_bom no) (on_board no) (dnp no) (uuid "a2391f0a-75f6-499e-a8c1-b8fbace360d8") (property "Reference" "#PWR911" (at 231.14 115.57 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Value" "GND" (at 231.14 119.38 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Footprint" "" (at 231.14 115.57 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 231.14 115.57 0) (hide yes) (effects (font (size 1.27 1.27))))(pin "1" (uuid "d8eb0905-dd60-476a-a2b4-c77ed2d9bdc3"))(instances (project "sms" (path "/87f5d4ab-27a5-46ca-95f3-e4337681b616/d3930066-088e-4aff-ad68-ba61075b344f" (reference "#PWR911") (unit 1)))))
	(text "ESP32-S3 core" (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left top)) (uuid "205628f3-d404-41bd-9c8b-ac23bfe7dfed"))
	(text "3V3 decoupling: C201 22uF + C202 100nF right next to U201 pin 2.\n\nEN / RESET: R201 + C203 (10k / 1uF, Espressif reference) delay EN at power-up\nso 3V3 is stable before the chip boots. SW201 pulls EN low = reset.\n\nBOOT: hold SW202 (IO0 low) and tap RESET to enter the USB bootloader.\nIO0 has an internal pull-up, so no resistor is fitted." (exclude_from_sim no) (at 15.24 27.94 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "06d0428c-f558-4228-aae4-4b36e4217acc"))
	(text "Logic-analyzer header J201 (DNP, 1x8 2.54 mm):\ntaps the 3.3 V side of the level shifter, to check\nthe modem power-up timing and the UART with a\ncheap 8-channel analyzer. Its labels join the\nhierarchical labels of the same name." (exclude_from_sim no) (at 205.74 76.2 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "bee96be7-fbc6-40f9-b09f-5d978955f437"))
	(text "Status LEDs (driven by firmware)" (exclude_from_sim no) (at 66.04 118.11 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left top)) (uuid "80c09460-b466-4263-82d8-763cb36008eb"))
	(text "Pin plan (rev 0.6, chosen so every group runs straight on the PCB):\n- IO19 / IO20: native USB D- / D+ (USB-C on the power sheet)\n- Bottom row, left: codec. IO3 I2S DOUT, IO46 LRCK, IO9 DIN, IO10 BCLK, IO11 MCLK, IO12 I2C SCL, IO13 SDA\n- Bottom row, right: IO14 modem RESET (NPN), IO21 NETLIGHT, IO47 RXD (ESP TX), IO48 TXD (ESP RX)\n- Right side: IO38 RTS, IO39 CTS, IO40 RI, IO41 DTR, IO42 STATUS; RXD0 free,\n  TXD0 = PWRKEY (through an NPN; the modem is unpowered while the ESP32 boots)\n- IO2 / IO1 (ADC1): VBAT and VBUS voltage monitoring. IO7: modem power switch enable. IO4 / IO5: status LEDs\n- IO35-37 are used by the octal PSRAM on N16R8: never use\n- IO46 (strapping) only carries LRCK, an ESP32 output, so it is low at boot; IO45 left free" (exclude_from_sim no) (at 15.24 160.02 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "515b8d54-4c73-461b-aed2-8708f0ee0243"))
